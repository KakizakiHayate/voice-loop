# voice-loop の設定。行頭の # を外すと有効になります。書き換えたら、プラグインの restart で反映されます。

# ハブに新しいセッションを立てさせる場所。この直下にある既存のフォルダだけが対象になります。
#VL_PROJECTS_DIR=~/projects

# ハブのタブを作る herdr のワークスペース名。空なら先頭のワークスペースに作ります。
#VL_HUB_WORKSPACE=

# ハブのモデル（sonnet / opus / haiku）
#VL_HUB_MODEL=sonnet

# 声のエンジン（aivis か voicevox）。voicevox は軽く、メモリの少ない Mac 向けです。入れ方は README の「準備」にあります。
#VL_VOICE=aivis

# 既定の声の ID。画面で声を選べば、そちらが優先されます。書かなければ、エンジンごとの既定（まお / 春日部つむぎ）になります。
# エンジンを替えるときは、この行を消すか、そのエンジンの声の ID に直してください。
#VL_DEFAULT_SPEAKER=888753760

# 聞き取り（whisper）と声のエンジンの場所。声の場所は、書かなければ VL_VOICE に合わせて決まります。
#VL_WHISPER=http://127.0.0.1:8080/v1/audio/transcriptions
#VL_VOICE_URL=http://127.0.0.1:10101

# 画面を開く名前を足すとき（カンマ区切り）。この Mac の名前と Tailscale の名前（〜.ts.net）は書かなくても通ります。
#VL_ALLOWED_HOSTS=

# uv を自分で決めた場所に入れている場合だけ、その場所を書きます（ふつうは自動で見つかります）。
#VL_UV=/path/to/uv

# 語り手（返答を話し言葉に直すモデル）。Anthropic の API を使います。
# `ant auth login` でログインしていれば、ここは何も書かなくて動きます。API キーを使うなら下に書きます。
#VL_NARRATOR_MODEL=claude-haiku-4-5
#ANTHROPIC_API_KEY=

# Hermes を使うとき（README「Hermes をハブにする」）。Docker の中の Hermes の API サーバーの場所と鍵。
# 鍵を書くと、話し相手の一覧に Hermes が出ます。鍵は Hermes 側に `hermes config set API_SERVER_KEY ...` で入れたものと同じにします。
#VL_HERMES_URL=http://127.0.0.1:8642
#VL_HERMES_KEY=
# Hermes 側の会話の名前の元。実際の名前は「元-日付」で、毎朝 VL_HERMES_RESET_HOUR 時に新しい会話になります（前の日の会話は持ち越しません。記憶と手順書は残ります）。
# 画面の 💡 の「ハブの会話を新しくする」でも新しくなります。
#VL_HERMES_SESSION=voice-loop
# 会話を新しくする時刻（0〜23。既定 4）。off にすると日ごとには変えません（会話が長くなるほど、1回ごとの費用が増えます）。
#VL_HERMES_RESET_HOUR=4
# ハブの頭。claude（herdr の中の Claude Code。既定）か hermes（上の Hermes がハブになり、読む・送る・答える・立てる・閉じるを同じ決まりで行う）。
# hermes にしたときは、hub フォルダの Claude Code は立てません（残っていればただのセッションとして見えます）。
#VL_HUB=claude
# Hermes がハブのとき、手順の書き足し（承認待ち）を画面の 💡 で採る・捨てるのと、Hermes の記憶を拾う役に渡すのに使う。
# Hermes の置き場（コンテナの /opt/data に見せているフォルダ）と、コンテナの名前。README のとおりに作ったなら書かなくて動きます。
# docker が PATH に無い場所にあれば VL_DOCKER に書きます。
#VL_HERMES_HOME=~/.hermes
#VL_HERMES_CONTAINER=hermes
#VL_DOCKER=
# コンテナから Mac へ届く接続を中継するプログラムの名前（頭の部分）。OrbStack と Docker は書かなくても見分けます。
# ほかのもの（podman・colima など）でコンテナを動かしているときだけ、カンマで区切って書きます（README「接続できる範囲」）。
#VL_CONTAINER_PROGRAMS=podman,colima

# off（メモリを空ける）で、本体と一緒に止める部品。空白かカンマで区切ります。on で上げ直します。
# コンテナ名（声のエンジンや Hermes を Docker で動かしている場合）と、launchd のサービスのラベル（聞き取りの whisper など）。
# ほかのツールも使っているサービスを書くと、off の間はそのツールからも使えなくなります。
#VL_OFF_CONTAINERS=aivis hermes
#VL_OFF_SERVICES=local.whisper-server

# プッシュ通知（画面の 🔔）で、配送サービス（iPhone なら Apple）に伝える連絡先。配送の側で困ったことがあったときに使われます。
# mailto:名前@ドメイン か、パスの無い https://ドメイン。配送サービスにはそのまま見えます。書かなければ、届かない宛先（mailto:voice-loop@localhost）を名乗ります。
#VL_PUSH_SUBJECT=mailto:you@example.com
# 承認・入力待ちで止まってから、通知するまで待つ秒数（その前に答えれば鳴りません）
#VL_BLOCKED_NOTIFY_AFTER=60

# いまの状況（拾う役）。あなたの録音（Plaud）・予定（Google カレンダー）・メール（Gmail）から、いま抱えている話題をまとめ直し、
# ハブが「hubctl context」で読みます。Claude Code の claude.ai 連携（Plaud・Google Calendar・Gmail）を使い、Claude Code の枠で動きます。
# 読むだけの道具に絞って動かします。README「いまの状況」を読んでから有効にしてください。
#VL_INTAKE=1
# 動かす曜日（1=月 … 7=日）と時（その時の5分に1回）
#VL_INTAKE_DAYS=1-5
#VL_INTAKE_HOURS=9-19
# 拾う役のモデルと、1回の上限（ドル相当）
#VL_INTAKE_MODEL=sonnet
#VL_INTAKE_BUDGET=1.00
# 見るメールの条件。あなたの宛先と、相手のドメイン（どちらもカンマ区切り）。ドメインを書かなければ、メールは見ません
#VL_INTAKE_ADDRESSES=you@example.com
#VL_INTAKE_DOMAINS=example.co.jp
# 動きの無い話題を外すまでの日数
#VL_INTAKE_FADE_DAYS=21
