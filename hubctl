    r = call("answer", body={"pane": a.pane, "answer": a.answer, "confirmed": a.confirmed})
    why = r.get("reason")
    if r.get("ok"):
        print(f"ユーザーの答えを伝えました → [{a.pane}] {r['project']}｜{r['title']}: {r['said']}\n続きが片づくと自動通知が届きます。")
        return
    screen = f"\n{QUOTE_NOTE}\n\n{r['screen']}" if r.get("screen") else ""
    msg = {
        "reporting": "いまは自動通知への応答中です。通知をきっかけに答えを送ることはできません。報告だけ行い、ユーザーの言葉を待ってください。",
        "trust": "Claude Code が「このフォルダを信頼しますか」と聞いて止まっています。これはハブからは答えられません。答えるのはユーザーで、そのセッションのタブで ↓ を押して「Yes, I trust this folder」を選び、Enter を押します（そのフォルダで初めて起動したときだけ出ます）。",
        "unreadable": "そのセッションの画面を読めませんでした。何を聞かれているか分からないまま答えは送れません。少し待ってからやり直すか、ユーザーに端末で見てもらってください。",
        "not_blocked": f"このセッションは止まっていません（状態: {STATUS.get(r.get('status'), r.get('status'))}）。答えるものがありません。",
        "unseen": "この問いはまだ確認していないか、確認したあとで変わっています。いまの画面は下のとおりです。中身をユーザーに伝え、ユーザーの次の発言で答えを聞いてから、もう一度実行してください。" + screen,
        "same_turn": "この問いを見たのと同じ発言の中では答えを送れません。ユーザーはまだ中身を聞いていないからです。中身を伝え、ユーザーの次の発言で答えを聞いてから実行してください。" + screen,
        "confirm": ("取り消しにくい操作に見えるので、まだ答えを送っていません。何が実行されるかをユーザーに伝えて「許可していいですか」と聞き、"
                    f"ユーザーが次の発言ではっきり許可したら `hubctl answer {a.pane} yes --confirmed` を実行してください。" + screen),
        "not_permission": f"これは許可の確認ではなく、選択肢のある質問です。番号で答えてください: {r.get('options')}",
        "bad_choice": f"その番号は選べません。選べるのは: {r.get('options')}（種類: {r.get('kind')}）",
        "bad_answer": "答えは yes / no / 番号 のどれかにしてください。",
        "not_asked": (f"ユーザーがいまの発言の直前に聞いたあなたの返答に、プロジェクト名「{r.get('project', '')}」と問い（「許可しますか？」「何番にしますか？」など）が入っていませんでした。"
                      "ユーザーは、どのセッションの何に答えるのか聞いていないかもしれません。プロジェクト名をそのまま入れて、何が実行されるかを伝えて聞き直し、ユーザーの次の発言で答えを聞いてください。" + screen),
        "not_said": (f"ユーザーの発言「{r.get('said', '')}」は、その答え（「はい」・番号）として読めませんでした（断る・保留・問い返しの語があるか、答え以外のことも言っている）。"
                     "断られたなら `no` を送るか、そのまま伝えてください。そうでなければ、プロジェクト名を入れて聞き直し、「はい」や「2番で」のように短く答えてもらってください。"),
    }.get(why, f"{why or r}")
    sys.exit("答えは送っていません: " + msg)


def cmd_send(a):
    text = " ".join(a.text)
    r = call("send", body={"pane": a.pane, "text": text})
    if r.get("ok"):
        note = "（作業中だったので、いまの作業のあとに読まれます）" if r.get("was_working") else ""
        print(f"送りました → [{a.pane}] {r['project']}｜{r['title']}{note}\n送った文: {' '.join(text.split())}\n"
              "片づくか、承認・入力待ちで止まると、あなたに自動通知が届きます。")
    elif r.get("reason") == "blocked":
        print(f"送れませんでした: [{a.pane}] は承認・入力待ちで止まっています。画面の末尾:\n{QUOTE_NOTE}\n\n{r.get('screen', '')}")
        sys.exit(1)
    elif r.get("reason") == "too_long":
        sys.exit(f"送れませんでした: 指示が長すぎます（{r['length']}字。上限 {r['max']}字・一段落）。要点に絞って送り直してください。")
    elif r.get("reason") == "proposal":
        sys.exit("送れませんでした: " + PROPOSAL_COPY.format(n=r.get("n")))
    elif r.get("reason") == "reporting":
        sys.exit("送れませんでした: いまは自動通知への応答中です。通知をきっかけに新しい指示は送れません（ユーザーの知らない連鎖を防ぐため）。報告だけ行い、次の指示はユーザーの言葉を待ってください。")
    else:
        sys.exit(f"送れませんでした: {r.get('reason', r)}")


def cmd_start(a):
    r = call("spawn", body={"project": a.project, "model": a.model, "text": " ".join(a.text)}, timeout=110)  # 起動に最大90秒かかる。Bash の打ち切り（120秒）より手前で返す
    why = r.get("reason")
    if r.get("ok"):
        if r["sent"]:
            tail = "最初の指示も送りました。片づくと自動通知が届きます。"
        else:
            tail = "最初の指示は送っていません。" + (
                f"立ち上がった直後に、何かを聞いて止まっています。`./hubctl screen {r['pane']}` で中身を見て、ユーザーに伝えてください。" if r.get("send_error") == "blocked"
                else f"（送信に失敗: {r['send_error']}）" if r.get("send_error") else "")
        print(f"セッションを立てました → [{r['pane']}] {r['project']}（モデル: {r['model']}）。{tail}")
        return
    msg = {
        "reporting": "いまは自動通知への応答中です。通知をきっかけにセッションは立てられません。",
        "no_project": "そのプロジェクトは、設定した置き場所の直下にありません。立てられるのは: " + ", ".join(r.get("projects", [])),
        "trust": f"セッションは立ち上がりました（[{r.get('pane')}]）が、最初の指示は送れていません。Claude Code が「このフォルダを信頼しますか」と聞いて止まっています。これはハブからは答えられません。答えるのはユーザーで、そのセッションのタブで ↓ を押して「Yes, I trust this folder」を選び、Enter を押します（そのフォルダで初めて起動したときだけ出ます）。答えてもらったあとで、send で指示を送り直してください。",
        "no_projects_dir": "セッションを立てる場所がまだ設定されていません。利用者が config.env の VL_PROJECTS_DIR に、プロジェクトの置き場所を書く必要があります。",
        "bad_model": "モデルは " + " / ".join(r.get("models", [])) + " から選んでください。",
        "too_long": f"最初の指示が長すぎます（{r.get('length')}字。上限 {r.get('max')}字・一段落）。",
        "proposal": PROPOSAL_COPY.format(n=r.get("n")),
    }.get(why, f"{why or r}")
    sys.exit("立てていません: " + msg)


def cmd_close(a):
    r = call("close", body={"pane": a.pane, "confirmed": a.confirmed})
    why = r.get("reason")
    if r.get("ok"):
        print(f"閉じました → [{a.pane}] {r['project']}｜{r['title']}（会話の記録は残っています）")
        return
    if why in ("confirm", "not_asked", "not_yes"):
        stops = {"working": "作業中なので、閉じると作業が途中で止まります。", "blocked": "承認・入力待ちで止まっています。閉じると、その問いには答えないまま終わります。"}
        lead = {
            "not_asked": "聞いたときのあなたの返答に、プロジェクト名と「閉じ」ていいかの問いが入っていませんでした。ユーザーは何を閉じるか聞いていないかもしれません。もう一度聞いてください。",
            "not_yes": f"ユーザーの答え「{r.get('said', '')}」は、はっきりした許可として読めませんでした（断る・保留・問い返しの語があるか、許可のほかのことも言っている）。断られたなら閉じずにそう伝え、そうでなければもう一度聞き、「はい」「閉じていいよ」のように短く答えてもらってください。",
        }.get(why, "")
        sys.exit(
            f"まだ閉じていません。{lead}閉じると取り消せないので、ユーザーのはっきりした許可が要ります。"
            f"どのセッションを閉じるかを、プロジェクト名「{r['project']}」をそのまま入れ、直近の依頼を添えてユーザーに伝え、「閉じていいですか」と聞いてください。"
            f"ユーザーが次の発言で「はい」「お願い」などとはっきり許可したら `./hubctl close {a.pane} --confirmed` を実行します。"
            "あいまいな答えのときや、ユーザーが別の話をはさんだときは閉じません（道具も、聞いたときの返答とユーザーの答えを確かめます）。\n"
            f"\n閉じる相手: [{a.pane}] {r['project']}｜{r['title']}　状態: {STATUS.get(r['status'], r['status'])}"
            f"{'　' + stops[r['status']] if r['status'] in stops else ''}\n{QUOTE_NOTE}\n直近の依頼: {one_line(r['last_user'])}")
    msg = {
        "reporting": "いまは自動通知への応答中です。通知をきっかけにセッションは閉じられません。",
        "same_turn": "閉じていいかを聞いたのと同じ発言の中では閉じられません。ユーザーはまだ何を閉じるか聞いていないからです。"
                     "中身を伝えて「閉じていいですか」と聞き、ユーザーの次の発言ではっきり許可されたら実行してください。",
        "unidentified": "このセッションは、まだ見分けるための ID がありません（会話を始める前など）。取り違えを防ぐため、ハブからは閉じられません。ユーザーに端末で閉じてもらってください。",
        "gone": f"セッションが見つかりません: {a.pane}（もう閉じられているか、ハブ自身です）。",
        "herdr": "herdr が閉じられませんでした。少し待ってから `./hubctl sessions` で様子を確かめてください。",
    }.get(why, f"{why or r}")
    sys.exit("閉じていません: " + msg)


def cmd_tasks(_):
    rows = call("tasks")
    active = sum(r["status"] in ("watching", "background", "blocked") for r in rows)
    print(f"頼んだ件 {len(rows)} 件（見張り中 {active} 件。終わった件は3日まで残ります）\n{QUOTE_NOTE}\n")
    for r in rows:
        print(f"[{r['pane']}] {r['project']}｜{r['title']}")
        print(f"  状態: {TASK_STATUS.get(r['status'], r['status'])}（{ago(r['since_minutes'])}に変化。{ago(r['age_minutes'])}に{TASK_KIND.get(r['kind'], r['kind'])}）")
        if r["text"]:
            print(f"  頼んだこと: {one_line(r['text'])}")
        if r["note"]:
            print(f"  メモ: {r['note']}")
        print()
    if not rows:
        print("（頼んだ件はありません）")


def cmd_context(a):
    r = call("context", {"q": " ".join(a.words)})
    print(f"{CONTEXT_NOTE}\n\n{r['text']}")


def cmd_proposals(_):
    r = call("proposals")
    print(f"{PROPOSAL_NOTE}\n\n{r['text']}")


NOT_ASKED = {
